# Common Configuration
# Comma-separated list of Device IPs or Hostnames
HOMEWIZZARD_DEVICES=192.168.1.10,homewizzard-p1
# Polling frequency in milliseconds (default: 5000)
HOMEWIZZARD_POLL_INTERVAL=5000
# Log level: trace, debug, info, warn, error, fatal (default: info)
HOMEWIZZARD_LOG_LEVEL=info

# Storage Option 1: InfluxDB (Primary)
# If these variables are set, the application will use InfluxDB.
# URL of your InfluxDB instance
INFLUX_URL=http://localhost:8086
# InfluxDB API Token
INFLUX_TOKEN=my-super-secret-auth-token
# InfluxDB Organization Name
INFLUX_ORG=my-org
# Target Bucket for measurements
INFLUX_BUCKET=homewizzard
# Bucket for application errors (optional, defaults to INFLUX_BUCKET)
# INFLUX_ERROR_BUCKET=homewizzard_errors

# Storage Option 2: Local File Storage (Fallback)
# If InfluxDB variables are NOT set, the application will check for HOMEWIZZARD_DATA_PATH.
# Local directory path to save JSON files
# HOMEWIZZARD_DATA_PATH=./data
